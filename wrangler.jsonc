{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-architecture-lab-dev",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-23",
  "vars": {
    "AUTH_MODE": "access",
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-architecture-lab-dev",
      "database_id": "ff8cd726-34f0-4b99-b2f0-de337141af0e",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    { "binding": "LAB_KV", "id": "f01c62eb91fb48d08b21e0a62372e368" },
  ],
  "r2_buckets": [
    {
      "binding": "LAB_R2",
      "bucket_name": "cloudflare-architecture-lab-dev-artifacts",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "LAB_QUEUE",
        "queue": "cloudflare-architecture-lab-dev-events",
      },
    ],
    "consumers": [
      {
        "queue": "cloudflare-architecture-lab-dev-events",
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        "max_retries": 2,
      },
    ],
  },
}
